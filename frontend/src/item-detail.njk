---
pagination:
    data: allItems
    size: 1
    alias: itemData
layout: layouts/base.njk
permalink: "{{ itemData.directory.path }}/items/{{ itemData.item.Id }}/"
eleventyComputed:
    title: "{{ itemData.item[itemData.directory.display.title_field] }}"
---

{% set item = itemData.item %}
{% set dir = itemData.directory %}

<article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back Button -->
    <div class="mb-8">
        <a href="{{ dir.path }}" class="inline-flex items-center text-gray-600 hover:text-primary transition-colors text-sm">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Zurück
        </a>
    </div>

    <!-- Article Header -->
    <header class="mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
            {{ item[dir.display.title_field] }}
        </h1>
        
        {% if item[dir.display.description_field] %}
        <p class="text-xl text-gray-600 leading-relaxed mb-8">
            {{ item[dir.display.description_field] }}
        </p>
        {% endif %}
    </header>
    
    <!-- Separator Line -->
    <div class="border-b border-1-5 border-text mb-8"></div>
    
    <!-- Properties Section (Select and Multi-Select) -->
    <div class="mb-8 space-y-3">
        {% if dir.display.status_field and item[dir.display.status_field] %}
        <div class="text-gray-700">
            <span class="font-medium">{{ dir.display.status_field.replace('_', ' ') | title }}:</span>
            <span class="ml-2">{{ item[dir.display.status_field] }}</span>
        </div>
        {% endif %}
        
        {# Display all select and multi-select fields #}
        {% for key, value in item %}
            {% if key != 'Id' and 
                  key != dir.display.title_field and 
                  key != dir.display.description_field and 
                  key != dir.display.status_field and
                  value and
                  value != '' and
                  value != 'null' and
                  value != 'undefined' %}
                {# Only show short values without line breaks (likely select/multi-select) #}
                {% set valueStr = value | string %}
                {% set hasLineBreak = valueStr | contains('\n') %}
                {% if valueStr.length < 200 and not hasLineBreak %}
                <div class="text-gray-700">
                    <span class="font-medium">{{ key.replace('_', ' ') | title }}:</span>
                    <span class="ml-2">
                        {% set hasComma = valueStr | contains(',') %}
                        {% set isDateValue = value | isDate %}
                        {% if isDateValue %}
                            {{ value | formatDate(true) }}
                        {% elif hasComma %}
                            {{ valueStr | cleanCommaList }}
                        {% else %}
                            {{ value }}
                        {% endif %}
                    </span>
                </div>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
    
    <!-- Separator Line -->
    <div class="border-b border-1-5 border-text mb-12"></div>

    <!-- Article Content (Text Fields with Markdown) -->
    <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-p:text-gray-700 prose-p:leading-relaxed prose-strong:text-gray-900">
        {# Display all text fields as article sections #}
        {% for key, value in item %}
            {% if key != 'Id' and 
                  key != dir.display.title_field and 
                  key != dir.display.description_field and 
                  key != dir.display.status_field and
                  value and
                  value != '' and
                  value != 'null' and
                  value != 'undefined' %}
                {# Only show long text values or those with line breaks #}
                {% set valueStr = value | string %}
                {% set hasLineBreak = valueStr | contains('\n') %}
                {% if valueStr.length >= 200 or hasLineBreak %}
                <section class="mb-12">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">
                        {{ key.replace('_', ' ') | title }}
                    </h2>
                    <div class="text-gray-700 leading-relaxed">
                        {{ valueStr | markdown | safe }}
                    </div>
                </section>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
</article>
