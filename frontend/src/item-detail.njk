---
pagination:
    data: allItems
    size: 1
    alias: itemData
layout: layouts/base.njk
permalink: "{{ itemData.directory.path }}/items/{{ itemData.item.Id }}/"
eleventyComputed:
    title: "{{ itemData.item[itemData.directory.display.title_field] }}"
---

{% set item = itemData.item %}
{% set dir = itemData.directory %}
{% set detailFields = dir.display.detail_fields | default([]) %}

<article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back Button -->
    <div class="mb-8">
        <a href="{{ dir.path }}" class="inline-flex items-center text-gray-600 hover:text-primary transition-colors text-sm" data-back-link>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Zurück
        </a>
    </div>

    <!-- Article Header -->
    <header class="mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
            {{ item[dir.display.title_field] }}
        </h1>
        
        {% if item[dir.display.excerpt_field] %}
        <p class="text-lg text-gray-600 leading-relaxed mb-8">
            {{ item[dir.display.excerpt_field] }}
        </p>
        {% endif %}
    </header>
    
    <!-- Separator Line -->
    <div class="border-b border-1-5 border-text mb-8"></div>
    
    <!-- Properties Section (Configured Meta Fields) -->
    {% if detailFields.length > 0 %}
    <div class="mb-8 space-y-3">
        {% for field in detailFields %}
            {% if field.section == 'meta' %}
                {% set value = item[field.field] %}
                {% if value and value != '' and value != 'null' and value != 'undefined' %}
                <div class="text-gray-700">
                    <span class="font-medium">{{ field.label }}:</span>
                    <span class="ml-2">
                        {% if field.type == 'month_year' %}
                            {{ value | formatDate }}
                        {% elif field.type == 'date_time' %}
                            {{ value | formatDate(true) }}
                        {% elif field.type == 'multi_select' %}
                            {{ value | cleanCommaList }}
                        {% else %}
                            {{ value }}
                        {% endif %}
                    </span>
                </div>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
    {% endif %}
    
    <!-- Separator Line -->
    <div class="border-b border-1-5 border-text mb-12"></div>

    <!-- Article Content (Configured Body Fields) -->
    {% if detailFields.length > 0 %}
    <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-p:text-gray-700 prose-p:leading-relaxed prose-strong:text-gray-900">
        {% for field in detailFields %}
            {% if field.section == 'body' %}
                {% set value = item[field.field] %}
                {% if value and value != '' and value != 'null' and value != 'undefined' %}
                <section class="mb-12">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">
                        {{ field.label }}
                    </h2>
                    <div class="text-gray-700 leading-relaxed">
                        {% if field.type == 'markdown' %}
                            {{ value | markdown | safe }}
                        {% else %}
                            {{ value }}
                        {% endif %}
                    </div>
                </section>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
    {% endif %}

    <!-- Files & Links -->
    {% if detailFields.length > 0 %}
    <div class="mt-12 space-y-8">
        <div class="space-y-3">
            {% for field in detailFields %}
                {% if field.section == 'files' %}
                    {% set value = item[field.field] %}
                    {% if value and value != '' and value != 'null' and value != 'undefined' %}
                    <div class="text-gray-700">
                        <span class="font-medium">{{ field.label }}:</span>
                        <span class="ml-2">
                        {% if field.type == 'file' %}
                                {% set fileUrl = value | attachmentUrl %}
                                {% if fileUrl %}
                                <a class="text-primary hover:underline" href="{{ fileUrl }}" target="_blank" rel="noopener noreferrer">{{ fileUrl }}</a>
                                {% else %}
                                {{ value }}
                                {% endif %}
                            {% else %}
                                {{ value }}
                            {% endif %}
                        </span>
                    </div>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>

        <div class="space-y-3">
            {% for field in detailFields %}
                {% if field.section == 'links' %}
                    {% set value = item[field.field] %}
                    {% if value and value != '' and value != 'null' and value != 'undefined' %}
                    <div class="text-gray-700">
                        <span class="font-medium">{{ field.label }}:</span>
                        <span class="ml-2">
                        {% if field.type == 'url' %}
                                {% set linkUrl = value | attachmentUrl %}
                                {% if linkUrl %}
                                <a class="text-primary hover:underline" href="{{ linkUrl }}" target="_blank" rel="noopener noreferrer">{{ linkUrl }}</a>
                                {% else %}
                                {{ value }}
                                {% endif %}
                            {% else %}
                                {{ value }}
                            {% endif %}
                        </span>
                    </div>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>
    </div>
    {% endif %}
</article>

<script>
  (function() {
    const link = document.querySelector('[data-back-link]');
    if (!link) return;
    const params = new URLSearchParams(window.location.search);
    const from = params.get('from');
    if (from && from.startsWith('/')) {
      link.href = from;
    }
  })();
</script>
