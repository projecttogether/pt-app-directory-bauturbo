---
pagination:
    data: allItems
    size: 1
    alias: itemData
layout: layouts/base.njk
permalink: "{{ itemData.directory.path }}/items/{{ itemData.item.Id }}/"
eleventyComputed:
    title: "{{ itemData.item[itemData.directory.display.title_field] }}"
---

{# SETUP #}
{#########}

{% set item = itemData.item %}
{% set dir = itemData.directory %}
{% set detailFields = dir.display.detail_fields | default([]) %}

{# MARKUP #}
{##########}

<article class="relative">

    {# Inner wrapper for placement of top/bottom horizontal border #}
    <div class="before:content-['_'] before:absolute before:top-0 before:w-full before:h-px before:bg-bauturbo-blau
                after:content-['_'] after:absolute after:bottom-(--mb) after:w-full after:h-px after:bg-bauturbo-blau">

        {# Inner layout wrapper #}
        <div class="relative max-w-page-content mx-auto">

            {# Back button #}
            {% set text = "← Zurück" %}
            {% set url = "/#praxiswissen" %}
            {% set size_btn = "md" %}
            {% set class = "absolute top-0" %}
            {% include "components/btns/btn-cta.njk" %}
            
            {# Page content #}
            <div class="px-5 sm:px-pad-content-section-x-tblt md:px-pad-content-section-x
                        pt-5 sm:pt-pad-content-section-y-tblt md:pt-pad-content-section-y
                        pb-[calc(var(--pb-inner)+var(--mb))]
                        grid grid-cols-12 md:gap-x-10
                        border-x border-bauturbo-blau">

                {# Header #}
                {% include "components/page-header/page-header-directory-item-details-page.njk" %}

                {# Separator Line #}
                <div class="col-span-12 border-b border-bauturbo-blau"></div>

                {# Item meta infos/properties (configured Meta Fields) #}
                {% if detailFields.length > 0 %}
                    <div class="col-span-12 mt-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                            {% for field in detailFields %}
                                {% if field.section == 'meta' %}
                                    {% set value = item[field.field] %}
                                    {% if value and value != '' and value != 'null' and value != 'undefined' %}
                                        <div class="col-span-1">
                                            <span class="text-label-xs leading-[1.42]! text-black">{{ field.label }}</span>
                                        </div>
                                        <div class="col-span-1">
                                            <span class="text-sm text-black">
                                                {% if field.type == 'month_year' %}
                                                    {{ value | formatDate }}
                                                {% elif field.type == 'date_time' %}
                                                    {{ value | formatDate(true) }}
                                                {% elif field.type == 'multi_select' %}
                                                    {{ value | cleanCommaList }}
                                                {% else %}
                                                    {{ value }}
                                                {% endif %}
                                            </span>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {# Separator Line #}
                <div class="col-span-12 border-b border-bauturbo-blau mt-8"></div>

                {# Item details/description #}
                {% if detailFields.length > 0 %}
                    <div class="col-span-12 mt-8">
                        {% for field in detailFields %}
                            {% if field.section == 'body' %}
                                {% set value = item[field.field] %}
                                {% if value and value != '' and value != 'null' and value != 'undefined' %}
                                    <section>
                                        {% set headingLevel = 2 %}
                                        {% set size = "md" %}
                                        {% set text_hdl = field.label %}
                                        {% set class = 'font-bold! mb-4' %}
                                        {% include "components/headlines/headline.njk" %}

                                        {% set size = "sm" %}
                                        {% set text = value %}
                                        {% set is_markdown = field.type == 'markdown' %}
                                        {% set class = null %}
                                        {% include "components/texts/text.njk" %}
                                    </section>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                {# Separator Line #}
                <div class="col-span-12 border-b border-bauturbo-blau mt-8"></div>

                {# Item files and links #}
                {% if detailFields.length > 0 %}
                    <div class="col-span-12 mt-8 space-y-8">

                        {% set headingLevel = 2 %}
                        {% set size = "md" %}
                        {% set text_hdl = 'Dateien und Referenzen' %}
                        {% set class = 'font-bold! mb-4' %}
                        {% include "components/headlines/headline.njk" %}
                        
                        {# Files #}
                        <div>
                            {% for field in detailFields %}
                                {% if field.section == 'files' %}
                                    {% set value = item[field.field] %}
                                    {% if value and value != '' and value != 'null' and value != 'undefined' %}
                                        <div>
                                            <span>
                                                {% if field.type == 'file' %}
                                                    {% set fileUrl = value | attachmentUrl %}
                                                    {% if fileUrl %}
                                                        {% set text = 'Datei herunterladen' %}
                                                        {% set url = fileUrl %}
                                                        {% set is_external = true %}
                                                        {% include "components/btns/btn-cta.njk" %}
                                                    {% else %}
                                                        {{ value }}
                                                    {% endif %}
                                                {% else %}
                                                    {% set text = 'Datei herunterladen' %}
                                                    {% set url = value %}
                                                    {% set is_external = true %}
                                                    {% include "components/btns/btn-cta.njk" %}
                                                {% endif %}
                                            </span>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        </div>

                        {# Links #}
                        <div>
                            {% for field in detailFields %}
                                {% if field.section == 'links' %}
                                    {% set value = item[field.field] %}
                                    {% if value and value != '' and value != 'null' and value != 'undefined' %}
                                        <div>
                                            <span class="font-medium">{{ field.label }}:</span>
                                            <span class="ml-2">
                                            {% if field.type == 'url' %}
                                                    {% set linkUrl = value | attachmentUrl %}
                                                    {% if linkUrl %}
                                                        {% set text = field.label %}
                                                        {% set url = linkUrl %}
                                                        {% set is_external = true %}
                                                        {% include "components/btns/btn-cta.njk" %}
                                                    {% else %}
                                                        {{ value }}
                                                    {% endif %}
                                                {% else %}
                                                    {{ value }}
                                                {% endif %}
                                            </span>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
                
            </div>
        </div>
    </div>

   
</article>

<script>
  (function() {
    const link = document.querySelector('[data-back-link]');
    if (!link) return;
    const params = new URLSearchParams(window.location.search);
    const from = params.get('from');
    if (from && from.startsWith('/')) {
      link.href = from;
    }
  })();
</script>
