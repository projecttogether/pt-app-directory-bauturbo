<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default(siteConfig.name) }}</title>
    {% if siteConfig.branding.favicon %}
    <link rel="icon" href="{{ siteConfig.branding.favicon }}">
    {% endif %}
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            /* Theme colors */
            --color-primary: {{ siteConfig.theme.colors.primary_accent }};
            --color-secondary: {{ siteConfig.theme.colors.secondary_accent }};
            --color-background: {{ siteConfig.theme.colors.background }};
            --color-text: {{ siteConfig.theme.colors.text }};
            --color-gray-light: {{ siteConfig.theme.colors.gray_light }};
            --color-gray-dark: {{ siteConfig.theme.colors.gray_dark }};
            
            /* Fonts */
            --font-heading: {{ siteConfig.theme.fonts.heading }};
            --font-body: {{ siteConfig.theme.fonts.body }};
        }
        
        body {
            font-family: var(--font-body);
            background-color: var(--color-background);
            color: var(--color-text);
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-heading);
        }
        
        /* Apply theme colors to various elements */
        .text-indigo-600, .text-primary {
            color: var(--color-primary) !important;
        }
        
        .bg-indigo-600, .bg-primary {
            background-color: var(--color-primary) !important;
        }
        
        .hover\:bg-indigo-700:hover {
            background-color: var(--color-secondary) !important;
        }
        
        .hover\:text-indigo-600:hover {
            color: var(--color-primary) !important;
        }
        
        .hover\:text-primary:hover {
            color: var(--color-primary) !important;
        }
        
        .border-indigo-500:focus {
            border-color: var(--color-primary) !important;
        }
        
        .ring-indigo-500:focus {
            --tw-ring-color: var(--color-primary) !important;
        }
        
        /* Custom border styles */
        .border-text {
            border-color: var(--color-text);
        }
        
        .border-1-5 {
            border-width: 1.5px;
        }
        
        html, body {
            min-height: 100vh;
            background-color: var(--color-background);
        }
        
        body {
            display: flex;
            flex-direction: column;
        }
        
        main {
            flex: 1;
        }
        
        /* Line clamp utility */
        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        /* Mobile filter toggle */
        @media (max-width: 1023px) {
            .filter-sidebar {
                position: fixed;
                top: 0;
                left: -100%;
                height: 100vh;
                width: 80%;
                max-width: 320px;
                background-color: var(--color-background);
                z-index: 50;
                transition: left 0.3s ease;
                overflow-y: auto;
                box-shadow: 2px 0 8px rgba(0,0,0,0.1);
                padding: 1rem;
            }
            
            .filter-sidebar.open {
                left: 0;
            }
            
            .filter-overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 40;
                display: none;
            }
            
            .filter-overlay.open {
                display: block;
            }
        }
        
        /* Link styling for article content */
        .prose a {
            color: var(--color-text);
            text-decoration: underline;
            text-decoration-color: var(--color-primary);
            text-decoration-thickness: 1.5px;
            text-underline-offset: 2px;
        }
        
        .prose a:hover {
            color: var(--color-primary);
        }
        
        /* Custom focus styles for form elements */
        select:focus,
        input:focus,
        textarea:focus,
        button:focus {
            outline: none;
            border-color: var(--color-text) !important;
            box-shadow: 0 0 0 1px var(--color-text) !important;
        }
        
        .filter-select:focus {
            border-color: var(--color-text) !important;
            box-shadow: 0 0 0 1px var(--color-text) !important;
        }
    </style>
</head>
<body class="text-gray-900 font-sans">
    <header style="background-color: var(--color-background);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <h1 class="text-xl font-bold text-primary">
                {% if siteConfig.branding.logo %}
                <img src="{{ siteConfig.branding.logo }}" alt="{{ siteConfig.name }}" class="h-8 inline-block">
                {% else %}
                {{ siteConfig.name }}
                {% endif %}
            </h1>
            <nav class="flex gap-6">
                {% for dir in directories %}
                <a href="{{ dir.path }}" class="text-gray-600 hover:text-primary transition-colors">
                    {{ dir.name }}
                </a>
                {% endfor %}
                {% if siteConfig.header_menu %}
                {% for item in siteConfig.header_menu %}
                <a href="{{ item.url }}" 
                   {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}
                   class="text-gray-600 hover:text-primary transition-colors">
                    {{ item.label }}
                </a>
                {% endfor %}
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="py-8">
        {{ content | safe }}
    </main>

    <footer style="background-color: var(--color-background);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex justify-between items-center">
                <div class="text-gray-500 text-sm">
                    {{ siteConfig.footer.text }}
                </div>
                {% if siteConfig.footer.menu %}
                <nav class="flex gap-6">
                    {% for item in siteConfig.footer.menu %}
                    <a href="{{ item.url }}" 
                       class="text-gray-500 hover:text-primary text-sm transition-colors">
                        {{ item.label }}
                    </a>
                    {% endfor %}
                </nav>
                {% endif %}
            </div>
        </div>
    </footer>
</body>
</html>
