<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default(siteConfig.name) }}</title>
    {% if siteConfig.branding.favicon %}
    <link rel="icon" href="{{ siteConfig.branding.favicon }}">
    {% endif %}
    <script src="https://cdn.usefathom.com/script.js" data-site="VUQWNMIH" defer></script>
    <link rel="stylesheet" href="/assets/styles/styles.css">
    <link rel="stylesheet" href="/assets/styles/content.css">
    <style>
        :root {
            /* Theme colors */
            --color-primary: {{ siteConfig.theme.colors.primary_accent }};
            --color-secondary: {{ siteConfig.theme.colors.secondary_accent }};
            --color-background: {{ siteConfig.theme.colors.background }};
            --color-text: {{ siteConfig.theme.colors.text }};
            --color-gray-light: {{ siteConfig.theme.colors.gray_light }};
            --color-gray-dark: {{ siteConfig.theme.colors.gray_dark }};
        }
        
        /* Apply theme colors to various elements */
        .text-indigo-600, .text-primary {
            color: var(--color-primary) !important;
        }
        
        .bg-indigo-600, .bg-primary {
            background-color: var(--color-primary) !important;
        }
        
        .hover\:bg-indigo-700:hover {
            background-color: var(--color-secondary) !important;
        }
        
        .hover\:text-indigo-600:hover {
            color: var(--color-primary) !important;
        }
        
        .hover\:text-primary:hover {
            color: var(--color-primary) !important;
        }
        
        .border-indigo-500:focus {
            border-color: var(--color-primary) !important;
        }
        
        .ring-indigo-500:focus {
            --tw-ring-color: var(--color-primary) !important;
        }
        
        /* Custom border styles */
        .border-text {
            border-color: var(--color-text);
        }
        
        .border-1-5 {
            border-width: 1.5px;
        }
        
        html, body {
            min-height: 100vh;
            background-color: var(--color-background);
        }
        
        body {
            display: flex;
            flex-direction: column;
        }
        
        main {
            flex: 1;
        }
        
        /* Line clamp utility */
        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        /* Mobile filter toggle */
        @media (max-width: 1023px) {
            .filter-sidebar {
                position: fixed;
                top: 0;
                left: -100%;
                height: 100vh;
                width: 80%;
                max-width: 320px;
                background-color: var(--color-background);
                z-index: 50;
                transition: left 0.3s ease;
                overflow-y: auto;
                box-shadow: 2px 0 8px rgba(0,0,0,0.1);
                padding: 1rem;
            }
            
            .filter-sidebar.open {
                left: 0;
            }
            
            .filter-overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 40;
                display: none;
            }
            
            .filter-overlay.open {
                display: block;
            }
        }
        
        /* Link styling for article content */
        .prose a {
            color: var(--color-text);
            text-decoration: underline;
            text-decoration-color: var(--color-primary);
            text-decoration-thickness: 1.5px;
            text-underline-offset: 2px;
        }
        
        .prose a:hover {
            color: var(--color-primary);
        }
        
        /* Custom focus styles for form elements */
        select:focus,
        input:focus,
        textarea:focus,
        button:focus {
            outline: none;
            border-color: var(--color-text) !important;
            box-shadow: 0 0 0 1px var(--color-text) !important;
        }
        
        .filter-select:focus {
            border-color: var(--color-text) !important;
            box-shadow: 0 0 0 1px var(--color-text) !important;
        }

        .site-frame::before,
        .site-frame::after {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            width: 1.5px;
            background: var(--color-primary);
            pointer-events: none;
        }

        /* .site-frame::before {
            left: max(0px, calc((100% - var(--content-max)) / 2));
        }

        .site-frame::after {
            left: min(100%, calc((100% + var(--content-max)) / 2));
        } */

        .site-footer {
            background-color: var(--color-background);
            /* border-top: 1.5px solid var(--color-primary); */
        }

        .footer-grid {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }

        .footer-text {
            color: var(--color-primary);
            font-size: 0.95rem;
            font-weight: 600;
        }

        .footer-links {
            display: flex;
            gap: 2rem;
        }

        .footer-link {
            color: var(--color-primary);
            font-weight: 600;
            text-decoration: none;
        }

        .footer-link:hover {
            color: var(--color-secondary);
        }

        @media (max-width: 768px) {
            .footer-grid {
                flex-direction: column;
                align-items: flex-start;
            }

            .footer-links {
                flex-wrap: wrap;
                gap: 1rem 1.5rem;
            }
        }
    </style>
</head>
<body data-near-top="true"
      class="group/body overflow-x-hidden_ text-gray-900 font-bundes-sans antialiased">
    <div class="site-frame overflow-x-hidden_">

        {# Site nav and header #}
        {% include "components/site-nav/site-nav.njk" %}
        {% include "components/site-header/site-header.njk" %}

        {# Main page content #}
        <main class="site-main">
            {{ content | safe }}
        </main>

        {# Site footer #}
        {% include "components/site-footer/site-footer.njk" %}

    </div>
    
    {# Global pop-up notification #}
    {% set popup_headline = "Wir ziehen um!" %}
    {% set popup_text = "Sie nutzten diese Webseite und möchten auch weiterhin Zugang zu Inhalten, Arbeitshilfen und Angeboten haben? Alle Informationen stehen Ihnen ab Anfang Juni auf der Webseite des BMWSB weiterhin zur Verfügung." %}
    {% set popup_button_text = "Mehr erfahren" %}
    {% set popup_button_url = "https://www.bmwsb.bund.de/DE/bauen/baurecht/bau-turbo/bau-turbo.html" %}
    {% include "components/pop-up-notification.njk" %}
    
    <script type="text/javascript" src="/assets/scripts/scroll-tracker.js"></script>
    <script type="text/javascript" src="/assets/scripts/toggle-extended-content.js"></script>
    <script type="text/javascript" src="/assets/scripts/site-nav.js"></script>
    <script type="text/javascript" src="/assets/scripts/pop-up-notification.js"></script>
    <script type="text/javascript" src="/assets/scripts/assets-list.js"></script>
</body>
</html>
