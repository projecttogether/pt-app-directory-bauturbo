<footer class="relative max-w-page-content mx-auto">

    <div class="px-5 sm:px-pad-content-section-x-tblt md:px-pad-content-section-x
                pt-5 sm:pt-pad-content-section-y-tblt md:pt-pad-content-section-y 
                pb-8
                border-x border-bauturbo-blau">

        <div class="grid grid-cols-12 sm:items-end max-sm:gap-y-8">

            {# Site footer text (copyright) #}
            <div class="col-span-12 sm:col-span-6 
                        text-sm text-bauturbo-blau">
                {{ siteConfig.footer.text }}
            </div>

            {# Site footer links #}
            {% if siteConfig.footer.menu %}
                <nav class="col-span-12 sm:col-span-6 
                            flex sm:justify-end gap-x-4">
                    {% for item in siteConfig.footer.menu %}
                        <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer"
                           class="text-sm text-bauturbo-blau">
                            {{ item.label }}
                        </a>
                    {% endfor %}
                </nav>
            {% endif %}
        </div>

    </div>

</footer>