{# IMPORTS #}
{###########}

{% from "utils/text-utils.njk" import hasContent %}

{# SETUP #}
{#########}

{% set mb = mb or "mb-75" %}
{% set section_id = section.anchor or section_id or "einstieg" %}

{% set has_text = hasContent(section.text) %}
{% set length_text = section.text | trim | length if has_text else 0 %}

{% set has_extendedContent = hasContent(section.text_extended) %}
{% set length_extendedText = section.text_extended | trim | length if has_extendedContent else 0 %}

{# Data for hardcoded content markup #}
{% set text_extended_praxiswissen %}{% include "content/praxiswissen-intro.md" %}{% endset %}

{# MARKUP #}
{##########}

<section id="{{ section_id }}"
         class="relative w-full">

    {# Inner wrapper for placement of top/bottom horizontal border #}
    <div class="before:content-['_'] before:absolute before:top-0 before:w-full before:h-px before:bg-bauturbo-blau
                after:content-['_'] after:absolute after:bottom-50 after:w-full after:h-px after:bg-bauturbo-blau">

        {# Inner layout wrapper #}
        <div class="relative max-w-page-content mx-auto">

            {# Section tag #}
            {% if section.tag %}
                {% set text_tag = section.tag %}
                {% include "components/tags/tag-page-section.njk" %}
            {% endif %}
            
            {# Section content #}
            <div class="px-pad-content-section-x py-pad-content-section-y pb-[260px]
                        grid grid-cols-12 gap-x-10
                        border-x border-bauturbo-blau">

                {# Headline #}
                {% if section.headline %}
                    {% set has_mb = section.subheadline or section.text %}    
                    <div class="col-span-12 {% if has_mb %} mb-10 {% endif %}">
                        {% set size = "lg" %}
                        {% set lvl = 2 %}
                        {% set text_hdl = section.headline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                {% endif %}

                {# Subheadline #}
                {% if section.subheadline %}
                    {% set has_mb = section.text %}
                    <div class="col-span-8 {% if has_mb %} mb-10 {% endif %}">
                        {% set size = "md" %}
                        {% set lvl = 3 %}
                        {% set text_hdl = section.subheadline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                {% endif %}
            
                {# Text #}
                {% if section.text %}
                    <div class="col-span-12">
                        {% set size = "sm" %}
                        {% set colCount = 2 if length_text > 750 else 1 %}
                        {% set text = section.text %}
                        {% include "components/texts/text.njk" %}
                    </div>
                {% endif %}

                {# Extended content #}
                {% if has_extendedContent %}
                    <div class="col-span-12 mt-10 grid grid-cols-12 gap-5">

                        {# "Arbeitshilfen" ext. content #}
                        {% set headline = "Arbeitshilfen für die Umsetzung" %}
                        {% set content = section.text_extended %}
                        {% set colCount = 2 if length_extendedText > 750 else 1 %}
                        {% set ctaText = "Mehr erfahren" %}
                        {% set ctaUrl = "#arbeitshilfen" %}
                        {% include "components/extended-content-toggle/extended-content-toggle.njk" %}

                        {# "Praxiswissen" ext. content #}
                        {% set headline = "Praxiswissen zum Bau-Turbo" %}
                        {% set content = text_extended_praxiswissen %}
                        {% set colCount = 1 %}
                        {% set ctaText = "Mehr erfahren" %}
                        {% set ctaUrl = "#praxiswissen" %}
                        {% include "components/extended-content-toggle/extended-content-toggle.njk" %}

                    </div>
                {% endif %}
                
            </div>

        </div>

    </div>

</section>