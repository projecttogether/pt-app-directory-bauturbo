{# Text block section component - receives section data from parent #}

{# SETUP #}
{#########}

{% set mb = mb or "mb-50" %}
{% if without_innerBottomPadd is not defined %}{% set without_innerBottomPadd = true %}{% endif %}
{% if with_border_t is not defined %}{% set with_border_t = true %}{% endif %}
{% if with_border_b is not defined %}{% set with_border_b = true %}{% endif %}
{% set with_border = with_border_t or with_border_b %}

{# MARKUP #}
{##########}

<section class="relative w-full px-pad-page-x {{ mb }}
                {% if with_border %}                         border-bauturbo-blau {% endif %}
                {% if with_border_t and with_border_b %}     border-y {% endif %}
                {% if with_border_t and not with_border_b %} border-t {% endif %}
                {% if with_border_b and not with_border_t %} border-b {% endif %}">

    {% if section.tag %}
        {% set text_tag = section.tag %}
        {% include "components/tags/tag-page-section.njk" %}
    {% endif %}
    
    <div class="px-pad-content-section-x py-pad-content-section-y
                {% if without_innerBottomPadd %} pb-0! {% endif %}
                grid grid-cols-12 gap-x-10
                border-x border-bauturbo-blau">

        <div class="col-span-9">
            {% if section.headline %}
                <div class="mb-6.75">
                    {% set size = "lg" %}
                    {% set lvl = 2 %}
                    {% set text_hdl = section.headline %}
                    {% include "components/headlines/headline.njk" %}
                </div>
            {% endif %}

            {% if section.subheadline %}
                <div class="{% if section.text %} mb-6.75 {% endif %}">
                    {% set size = "md" %}
                    {% set lvl = 3 %}
                    {% set text_hdl = section.subheadline %}
                    {% include "components/headlines/headline.njk" %}
                </div>
            {% endif %}
        
            {% if section.text %}
                <div>
                    {% set size = "sm" %}
                    {% set text = section.text %}
                    {% include "components/texts/text.njk" %}
                </div>
            {% endif %}
        </div>
        
    </div>

</section>