{# SETUP #}

{% set pageData = pages[page_id] | default({}) %}
{% set sections = pageData.sections | default([]) %}

{# MARKUP #}

{% if not pageData or sections.length == 0 %}
    <div class="max-w-3xl mx-auto px-4 py-16 text-theme-muted">
        Kein Seiteninhalt gefunden.
    </div>
{% else %}

{% for section in sections %}

    {% if section.type == "hero" %}
        
        {% include "components/sections/page-section-hero.njk" %}

    {% elseif section.type == "intro" %}
        <section class="relative w-full pl-40 pr-50 mb-50
                        border-y border-bauturbo-blau">

            {% if section.tag %}
            {% set text_tag = section.tag %}
            {% include "components/tags/tag-page-section.njk" %}
            {% endif %}
            
            <div class="pl-10 pt-7 pb-9 grid grid-cols-12 gap-x-10
                        border-x border-bauturbo-blau">

                <div class="col-span-9">
                    {% if section.headline %}
                    <div class="mb-10">
                        {% set size = "lg" %}
                        {% set lvl = 2 %}
                        {% set text_hdl = section.headline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}

                    {% if section.subheadline %}
                    <div>
                        {% set size = "md" %}
                        {% set lvl = 3 %}
                        {% set text_hdl = section.subheadline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}
                
                    {% if section.text %}
                    <div class="mt-10">
                        {% set size = "sm" %}
                        {% set text = section.text %}
                        {% include "components/texts/text.njk" %}
                    </div>
                    {% endif %}
                </div>
                
            </div>

        </section>
    {% elseif section.type == "text_block" %}
        <section class="relative w-full pl-40 pr-50 mb-50
                        border-y border-bauturbo-blau">

            {% if section.tag %}
            {% set text_tag = section.tag %}
            {% include "components/tags/tag-page-section.njk" %}
            {% endif %}
            
            <div class="pl-10 pt-7 pb-9 grid grid-cols-12 gap-x-10
                        border-x border-bauturbo-blau">

                <div class="col-span-9">
                    {% if section.headline %}
                    <div class="mb-10">
                        {% set size = "lg" %}
                        {% set lvl = 2 %}
                        {% set text_hdl = section.headline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}

                    {% if section.subheadline %}
                    <div>
                        {% set size = "md" %}
                        {% set lvl = 3 %}
                        {% set text_hdl = section.subheadline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}
                
                    {% if section.text %}
                    <div class="mt-10">
                        {% set size = "sm" %}
                        {% set text = section.text %}
                        {% include "components/texts/text.njk" %}
                    </div>
                    {% endif %}
                </div>
                
            </div>

        </section>
    {% elseif section.type == "directory_tabs" %}
        <section class="relative w-full pl-40 pr-50 mb-50
                        border-y border-bauturbo-blau">

            {% if section.tag %}
            {% set text_tag = section.tag %}
            {% include "components/tags/tag-page-section.njk" %}
            {% endif %}
            
            <div class="pl-10 pt-7 pb-9 grid grid-cols-12 gap-x-10
                        border-x border-bauturbo-blau">

                <div class="col-span-9">
                    {% if section.headline %}
                    <div class="mb-10">
                        {% set size = "lg" %}
                        {% set lvl = 2 %}
                        {% set text_hdl = section.headline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}

                    {% if section.subheadline %}
                    <div>
                        {% set size = "md" %}
                        {% set lvl = 3 %}
                        {% set text_hdl = section.subheadline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}

                    {% if section.text %}
                    <div class="mt-10">
                        {% set size = "sm" %}
                        {% set text = section.text %}
                        {% include "components/texts/text.njk" %}
                    </div>
                    {% endif %}

                </div>
                
            </div>

            {% include "components/directories-tabs.njk" %}

        </section>
    {% elseif section.type == "call_to_action" %}
        <section class="relative w-full pl-40 pr-50 mb-50
                        border-y border-bauturbo-blau">

            {% if section.tag %}
            {% set text_tag = section.tag %}
            {% include "components/tags/tag-page-section.njk" %}
            {% endif %}
            
            <div class="pl-10 pt-7 pb-9 grid grid-cols-12 gap-x-10
                        border-x border-bauturbo-blau">

                <div class="col-span-9">
                    {% if section.headline %}
                    <div class="mb-10">
                        {% set size = "lg" %}
                        {% set lvl = 2 %}
                        {% set text_hdl = section.headline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}

                    {% if section.subheadline %}
                    <div class="mt">
                        {% set size = "md" %}
                        {% set lvl = 3 %}
                        {% set text_hdl = section.subheadline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}

                    {% if section.text %}
                    <div class="mt-10">
                        {% set size = "sm" %}
                        {% set text = section.text %}
                        {% include "components/texts/text.njk" %} 
                    </div>
                    {% endif %}

                    {% if section.cta_label and section.cta_url %}
                    <div class="mt-10">
                        <a class="inline-flex items-center px-4 py-2 text-sm font-semibold border directories-button"
                        href="{{ section.cta_url }}"
                        target="_blank"
                        rel="noopener noreferrer">
                            {{ section.cta_label }}
                        </a>
                    </div>
                    {% endif %}

                </div>
                
            </div>

        </section>
    {% elseif section.type == "about" %}
        <section class="relative w-full pl-40 pr-50 mb-50
                        border-y border-bauturbo-blau">

            {% if section.tag %}
            {% set text_tag = section.tag %}
            {% include "components/tags/tag-page-section.njk" %}
            {% endif %}
            
            <div class="pl-10 pt-7 pb-9 grid grid-cols-12 gap-x-10
                        border-x border-bauturbo-blau">

                <div class="col-span-9">
                    {% if section.headline %}
                    <div class="mb-10">
                        {% set size = "lg" %}
                        {% set lvl = 2 %}
                        {% set text_hdl = section.headline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}

                    {% if section.subheadline %}
                    <div>
                        {% set size = "md" %}
                        {% set lvl = 3 %}
                        {% set class = "font-normal! text-black!" %}
                        {% set text_hdl = section.subheadline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                    {% endif %}

                    {% if section.text %}
                    <div class="mt-10">
                        {% set size = "sm" %}
                        {% set text = section.text %}
                        {% include "components/texts/text.njk" %} 
                    </div>
                    {% endif %}
        
                </div>
                
            </div>

        </section>
    {% endif %}
{% endfor %}
{% endif %}
