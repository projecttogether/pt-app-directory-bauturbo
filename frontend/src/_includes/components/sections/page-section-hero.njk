{# Hero section component - receives section data from parent #}

{# SETUP #}
{#########}

{% set section_id = section.anchor or section_id or "hero" %}

{# Spacing/sizing #}
{% set mb = mb or 17.5 %}

{# MARKUP #}
{##########}

<section id="{{ section_id }}"
         class="relative w-full"
         style="--mb: {{ mb }}rem;
                --pb-inner: 3.75rem;">

    {# Inner wrapper for placement of top/bottom horizontal border #}
    <div class="before:content-['_'] before:absolute before:top-0 before:w-full before:h-px before:bg-bauturbo-blau
                after:content-['_'] after:absolute after:bottom-(--mb) after:w-full after:h-px after:bg-bauturbo-blau">

        {# Inner layout wrapper #}
        <div class="relative max-w-page-content mx-auto">

    {# Section tag #}
    {% if section.tag %}
        {% set text_tag = section.tag %}
        {% include "components/tags/tag-page-section.njk" %}
    {% endif %}

    {# Section content #}
    <div class="px-[3.5rem] pt-[1.75rem]
                pb-[calc(var(--pb-inner)+var(--mb))]
                grid grid-cols-12 gap-x-10
                border-x border-bauturbo-blau">

        <div class="col-span-12">
            {# Headline #}
            {% set has_mb = section.text %}
            <div class="{% if has_mb %} mb-10 {% endif %}">
                {% if section.headline %}
                    {% set size = "xl" %}
                    {% set lvl = 1 %}
                    {% set text_hdl = section.headline %}
                    {% include "components/headlines/headline.njk" %}
                {% endif %}
            </div>
        </div>

        <div class="col-span-9">
            {# Text #}
            {% if section.text %}
                {% set has_mb = section.cta_label %}
                <div class="{% if has_mb %} mb-10 {% endif %}">
                    {% set size = "sm-plus" %}
                    {% set text = section.text %}
                    {% include "components/texts/text.njk" %}
                </div>
            {% endif %}

            {# Call-to-action #}
            {% if section.cta_label and section.cta_url %}
                <footer>
                    <a  class="inline-flex items-center px-4 py-2 text-sm font-semibold border directories-button"
                        href="{{ section.cta_url }}"
                        target="_blank"
                        rel="noopener noreferrer">
                        {{ section.cta_label }}
                    </a>
                </footer>
            {% endif %}
        </div>

    </div>
    </div>
    </div>

</section>