{# Directory tabs section component - receives section data from parent #}

{# SETUP #}
{#########}

{% set section_id = section.anchor or section_id or "praxiswissen" %}

{# Spacing/sizing #}
{% set mb = mb or 17.5 %}

{# MARKUP #}
{##########}

<section id="{{ section_id }}"
         data-directory-tabs-root
         class="relative w-full"
         style="--mb: {{ mb }}rem;
                --pb-inner: 2rem;">

    {# Inner wrapper for placement of top/bottom horizontal border #}
    <div class="before:content-['_'] before:absolute before:top-0 before:w-full before:h-px before:bg-bauturbo-blau
                after:content-['_'] after:absolute after:bottom-(--mb) after:w-full after:h-px after:bg-bauturbo-blau">

        {# Inner layout wrapper #}
        <div class="relative max-w-page-content mx-auto">

            {# Section tag #}
            {% if section.tag %}
                {% set text_tag = section.tag %}
                {% include "components/tags/tag-page-section.njk" %}
            {% endif %}
            
            {# Section content #}
            <div class="px-5 sm:px-pad-content-section-x-tblt md:px-pad-content-section-x
                        py-5 sm:py-pad-content-section-y-tblt md:py-pad-content-section-y
                        grid grid-cols-12 md:gap-x-10
                        border-x border-bauturbo-blau">

                {# Headline #}
                {% if section.headline %}
                    {% set has_mb = section.subheadline or section.text %}
                    <div class="col-span-12 {% if has_mb %} mb-6 sm:mb-10 {% endif %}">
                        {% set size = "lg" %}
                        {% set lvl = 2 %}
                        {% set text_hdl = section.headline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                {% endif %}

                {# Subheadline #}
                {% if section.subheadline %}
                    {% set has_mb = section.text %}
                    <div class="col-span-12 lg:col-span-8 {% if has_mb %} mb-6 sm:mb-10 {% endif %}">
                        {% set size = "md" %}
                        {% set lvl = 3 %}
                        {% set text_hdl = section.subheadline %}
                        {% include "components/headlines/headline.njk" %}
                    </div>
                {% endif %}

                {# Text #}
                {% if section.text %}
                    <div class="col-span-12 lg:col-span-8">
                        {% set size = "sm" %}
                        {% set text = section.text %}
                        {% include "components/texts/text.njk" %}
                    </div>
                {% endif %}
                
            </div>

            {% include "components/directories-tabs/directories-tabs.njk" %}

        </div>
    </div>
</section>
