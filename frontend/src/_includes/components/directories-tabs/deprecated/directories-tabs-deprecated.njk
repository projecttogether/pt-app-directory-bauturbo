{% set directoryList = directories | default([]) %}

<section class="content-container page-section">
  {% if directoryList.length > 0 %}
  <div class="mt-8">
    <div class="directories-label mb-3">Kategorien</div>
    <div class="flex flex-wrap gap-2 pb-4" role="tablist" aria-label="Verzeichnisse">
      {% for directory in directoryList %}
      <button
        type="button"
        id="tab-{{ directory.id }}"
        class="tab-button directories-tab px-4 py-2 text-sm font-semibold transition-colors {% if loop.first %}directories-tab-active{% endif %}"
        data-tab-button="{{ directory.id }}"
        role="tab"
        aria-selected="{% if loop.first %}true{% else %}false{% endif %}"
        aria-controls="panel-{{ directory.id }}"
        tabindex="{% if loop.first %}0{% else %}-1{% endif %}"
      >
        {{ directory.name }}
      </button>
      {% endfor %}
    </div>
  </div>

  <div class="mt-8">
    {% for directory in directoryList %}
    <section
      id="panel-{{ directory.id }}"
      class="tab-panel {% if not loop.first %}hidden{% endif %}"
      data-tab-panel="{{ directory.id }}"
      role="tabpanel"
      aria-labelledby="tab-{{ directory.id }}"
    >
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
        <div class="max-w-3xl">
          <h3 class="text-2xl font-bold text-primary">{{ directory.name }}</h3>
          {% if directory.description %}
          <p class="mt-3 text-theme-muted leading-relaxed">{{ directory.description }}</p>
          {% endif %}
        </div>
        <a href="{{ directory.path }}" class="inline-flex items-center text-sm font-semibold text-primary hover:underline">
          Alle Eintraege anzeigen
        </a>
      </div>

      <div class="mt-8 border-b border-1-5 directories-border"></div>

      <div class="mt-8 flex flex-col lg:flex-row gap-8">
        <aside class="lg:w-64 flex-shrink-0">
          <div class="p-4 border-1-5 directories-border bg-theme">
            <div class="mb-4 pb-4" style="border-bottom: 1.5px solid var(--color-primary);">
              <div class="directories-label mb-3">Suche</div>
              <input type="text"
                     class="block w-full px-3 py-2 text-sm rounded-md border bg-theme"
                     style="border-color: var(--color-primary);"
                     placeholder="Stichwort eingeben..."
                     data-search-input>
            </div>

            <div class="flex items-center justify-between mb-4">
              <div class="directories-label">Filter</div>
              <button type="button" class="text-xs directories-filter-text transition-colors" data-clear-filters>
                Alle Filter loeschen
              </button>
            </div>

            <div class="space-y-4" data-filter-container>
              {% for filter in directory.filters %}
              <div class="pb-4 last:pb-0" style="border-bottom: 1.5px solid var(--color-primary); {% if loop.last %}border-bottom: none;{% endif %}">
                <details class="group" open>
                  <summary class="cursor-pointer list-none flex items-center justify-between text-sm font-medium directories-filter-text">
                    <span class="directories-label">{{ filter.label }}</span>
                    <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </summary>
                  <div class="mt-3">
                    {% if filter.type == 'date_range' %}
                      <div data-filter-name="{{ filter.field }}" data-filter-type="{{ filter.type }}">
                        <div class="space-y-2 mb-4">
                          <label class="flex items-center cursor-pointer bg-theme-hover p-1 rounded transition-colors">
                            <input type="radio"
                                   class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                   style="border-color: var(--color-primary); accent-color: var(--color-primary);"
                                   name="date-period-{{ directory.id }}-{{ filter.field }}"
                                   data-filter-name="{{ filter.field }}"
                                   data-filter-type="{{ filter.type }}"
                                   value="all"
                                   checked>
                            <span class="ml-2 text-sm directories-filter-text">Alle Einträge</span>
                          </label>
                          <label class="flex items-center cursor-pointer bg-theme-hover p-1 rounded transition-colors">
                            <input type="radio"
                                   class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                   style="border-color: var(--color-primary); accent-color: var(--color-primary);"
                                   name="date-period-{{ directory.id }}-{{ filter.field }}"
                                   data-filter-name="{{ filter.field }}"
                                   data-filter-type="{{ filter.type }}"
                                   value="upcoming">
                            <span class="ml-2 text-sm directories-filter-text">In der Zukunft</span>
                          </label>
                          <label class="flex items-center cursor-pointer bg-theme-hover p-1 rounded transition-colors">
                            <input type="radio"
                                   class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                   style="border-color: var(--color-primary); accent-color: var(--color-primary);"
                                   name="date-period-{{ directory.id }}-{{ filter.field }}"
                                   data-filter-name="{{ filter.field }}"
                                   data-filter-type="{{ filter.type }}"
                                   value="past">
                            <span class="ml-2 text-sm directories-filter-text">In der Vergangenheit</span>
                          </label>
                        </div>

                        {% if filter.years.length > 0 %}
                        <div>
                          <label class="block text-xs font-medium directories-filter-text mb-2">Jahr (optional)</label>
                          <select class="filter-date-year block w-full px-3 py-2 text-sm rounded-md border bg-theme"
                                  style="border-color: var(--color-primary);"
                                  data-filter-name="{{ filter.field }}"
                                  data-filter-type="{{ filter.type }}">
                            <option value="">Alle Jahre</option>
                            {% for year in filter.years %}
                            <option value="{{ year }}">{{ year }}</option>
                            {% endfor %}
                          </select>
                        </div>
                        {% endif %}
                      </div>
                    {% elif filter.type == 'multi_select' %}
                      <div class="space-y-2 max-h-60 overflow-y-auto" data-filter-name="{{ filter.field }}" data-filter-type="{{ filter.type }}">
                        {% for option in filter.options %}
                        <label class="flex items-center cursor-pointer bg-theme-hover p-1 rounded transition-colors">
                          <input type="checkbox"
                                 class="filter-checkbox rounded text-primary focus:ring-0 focus:ring-offset-0"
                                 style="border-color: var(--color-primary); accent-color: var(--color-primary);"
                                 data-filter-name="{{ filter.field }}"
                                 data-filter-type="{{ filter.type }}"
                                 value="{{ option }}">
                          <span class="ml-2 text-sm directories-filter-text">{{ option }}</span>
                        </label>
                        {% endfor %}
                      </div>
                    {% else %}
                      <select class="filter-select block w-full px-3 py-2 text-sm rounded-md border bg-theme"
                              style="border-color: var(--color-primary);"
                              data-filter-name="{{ filter.field }}"
                              data-filter-type="{{ filter.type }}">
                        <option value="">Alle</option>
                        {% for option in filter.options %}
                        <option value="{{ option }}">{{ option }}</option>
                        {% endfor %}
                      </select>
                    {% endif %}
                  </div>
                </details>
              </div>
              {% endfor %}
            </div>
          </div>
        </aside>

        <div class="flex-1">
          <div class="flex items-center justify-between text-sm font-semibold text-theme mb-4">
            {% set itemCount = directory.items | length %}
            <span class="directories-label" data-results-count>
              {{ itemCount }} {% if itemCount == 1 %}ERGEBNIS{% else %}ERGEBNISSE{% endif %}
            </span>
            <div class="directories-pagination" data-pagination></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" data-items-grid>
            {% for item in directory.items %}
            <article class="item-card group directories-card bg-theme p-6 transition-shadow hover:shadow-md"
                     {% for filter in directory.filters %}
                       {% set value = item[filter.field] %}
                       {% if value %}
                       data-{{ filter.field }}="{{ value | attrSafe }}"
                       {% endif %}
                     {% endfor %}
            >
              <a href="{{ directory.path }}/items/{{ item.Id }}/?from={{ page.url | default('/') }}" class="block">
                <h4 class="text-lg font-semibold directories-title group-hover:text-primary transition-colors">
                  {{ item[directory.display.title_field] }}
                </h4>
                <div class="flex items-center gap-2 text-xs text-theme-soft mt-2">
                  {% if directory.display.status_field and item[directory.display.status_field] %}
                  <span class="inline-flex items-center px-2 py-0.5 directories-pill">
                    {{ item[directory.display.status_field] }}
                  </span>
                  {% endif %}
                  {% if directory.display.start_date_field and item[directory.display.start_date_field] %}
                  <span>
                    {{ item[directory.display.start_date_field] | formatDate }}
                  </span>
                  {% endif %}
                </div>
                {% if directory.display.excerpt_field and item[directory.display.excerpt_field] %}
                <p class="mt-3 text-sm text-theme-muted leading-relaxed">
                  {{ item[directory.display.excerpt_field] | truncateChars(200) }}
                </p>
                {% endif %}
                <span class="inline-flex items-center px-3 py-1.5 mt-4 text-sm font-semibold border directories-button">
                  Mehr erfahren
                </span>
              </a>
            </article>
            {% else %}
            <div class="col-span-full text-center py-12 text-theme-muted">
              Keine veroeffentlichten Eintraege gefunden.
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
    {% endfor %}
  </div>
  {% else %}
  <div class="mt-8 border-1-5 directories-border bg-theme p-8 text-center text-theme-muted">
    Derzeit sind keine Verzeichnisse verfuegbar. Bitte pruefen Sie die NocoDB-Konfiguration.
  </div>
  {% endif %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = Array.from(document.querySelectorAll('[data-tab-button]'));
    const tabPanels = Array.from(document.querySelectorAll('[data-tab-panel]'));

    if (!tabButtons.length || !tabPanels.length) {
      return;
    }

    function activateTab(tabId) {
      tabButtons.forEach(button => {
        const isActive = button.dataset.tabButton === tabId;
        button.classList.toggle('directories-tab-active', isActive);
        button.setAttribute('aria-selected', isActive ? 'true' : 'false');
        button.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      tabPanels.forEach(panel => {
        const isActive = panel.dataset.tabPanel === tabId;
        panel.classList.toggle('hidden', !isActive);
        panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });
    }

    function setupFilters(panel) {
      const selectFilters = panel.querySelectorAll('.filter-select');
      const checkboxFilters = panel.querySelectorAll('.filter-checkbox');
      const datePeriodFilters = panel.querySelectorAll('.filter-date-period');
      const dateYearFilters = panel.querySelectorAll('.filter-date-year');
      const searchInput = panel.querySelector('[data-search-input]');
      const cards = panel.querySelectorAll('.item-card');
      const clearButton = panel.querySelector('[data-clear-filters]');
      const resultsCount = panel.querySelector('[data-results-count]');
      const pagination = panel.querySelector('[data-pagination]');
      const panelId = panel.dataset.tabPanel;
      const storageKey = `directoryFilters:${panelId}`;
      const pageSize = 9;
      let currentPage = 1;

      function updateResultsCount(totalCount) {
        if (!resultsCount) return;
        resultsCount.textContent = `${totalCount} ${totalCount === 1 ? 'ERGEBNIS' : 'ERGEBNISSE'}`;
      }

      function renderPagination(totalItems) {
        if (!pagination) return;
        pagination.innerHTML = '';
        const totalPages = Math.ceil(totalItems / pageSize);
        if (totalPages <= 1) {
          return;
        }

        for (let page = 1; page <= totalPages; page += 1) {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(page);
          button.className = `directories-pagination-button${page === currentPage ? ' active' : ''}`;
          button.addEventListener('click', () => {
            currentPage = page;
            filterCards();
          });
          pagination.appendChild(button);
        }
      }

      function applyPagination(matchingCards) {
        cards.forEach(card => {
          card.style.display = 'none';
        });

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = startIndex + pageSize;
        matchingCards.slice(startIndex, endIndex).forEach(card => {
          card.style.display = 'block';
        });
      }

      function filterCards() {
        const activeFilters = {};
        const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';

        datePeriodFilters.forEach(radio => {
          if (radio.checked) {
            const filterName = radio.dataset.filterName;
            if (!activeFilters[filterName]) {
              activeFilters[filterName] = { type: 'date_range' };
            }
            activeFilters[filterName].period = radio.value;
          }
        });

        dateYearFilters.forEach(select => {
          if (select.value) {
            const filterName = select.dataset.filterName;
            if (!activeFilters[filterName]) {
              activeFilters[filterName] = { type: 'date_range' };
            }
            activeFilters[filterName].year = parseInt(select.value, 10);
          }
        });

        selectFilters.forEach(select => {
          if (select.value) {
            activeFilters[select.dataset.filterName] = {
              value: select.value,
              type: select.dataset.filterType
            };
          }
        });

        const checkboxesByFilter = {};
        checkboxFilters.forEach(checkbox => {
          const filterName = checkbox.dataset.filterName;
          if (!checkboxesByFilter[filterName]) {
            checkboxesByFilter[filterName] = [];
          }
          if (checkbox.checked) {
            checkboxesByFilter[filterName].push(checkbox.value);
          }
        });

        for (const [filterName, values] of Object.entries(checkboxesByFilter)) {
          if (values.length > 0) {
            activeFilters[filterName] = {
              values: values,
              type: 'multi_select'
            };
          }
        }

        const now = new Date();
        now.setHours(0, 0, 0, 0);

        const matchingCards = [];

        cards.forEach(card => {
          let isVisible = true;

          for (const [key, filterConfig] of Object.entries(activeFilters)) {
            const cardValue = card.getAttribute(`data-${key}`);

            if (filterConfig.type === 'date_range') {
              if (!cardValue) {
                isVisible = false;
                break;
              }

              const cardDate = new Date(cardValue);
              if (isNaN(cardDate.getTime())) {
                isVisible = false;
                break;
              }

              if (filterConfig.period === 'upcoming' && cardDate < now) {
                isVisible = false;
                break;
              }
              if (filterConfig.period === 'past' && cardDate >= now) {
                isVisible = false;
                break;
              }

              if (filterConfig.year && cardDate.getFullYear() !== filterConfig.year) {
                isVisible = false;
                break;
              }

              continue;
            }

            if (!cardValue) {
              isVisible = false;
              break;
            }

            if (filterConfig.type === 'multi_select') {
              const cardValues = cardValue.split(',').map(v => v.trim());
              const hasMatch = filterConfig.values.some(filterVal => cardValues.includes(filterVal));
              if (!hasMatch) {
                isVisible = false;
                break;
              }
            } else if (cardValue !== filterConfig.value) {
              isVisible = false;
              break;
            }
          }

          if (isVisible && searchTerm) {
            const cardText = card.textContent.toLowerCase();
            if (!cardText.includes(searchTerm)) {
              isVisible = false;
            }
          }

          if (isVisible) {
            matchingCards.push(card);
          }
        });

        const totalMatches = matchingCards.length;
        const totalPages = Math.max(1, Math.ceil(totalMatches / pageSize));
        if (currentPage > totalPages) {
          currentPage = 1;
        }
        updateResultsCount(totalMatches);
        renderPagination(totalMatches);
        applyPagination(matchingCards);
      }

      function clearAllFilters() {
        selectFilters.forEach(select => {
          select.value = '';
        });
        checkboxFilters.forEach(checkbox => {
          checkbox.checked = false;
        });
        datePeriodFilters.forEach(radio => {
          radio.checked = radio.value === 'all';
        });
        dateYearFilters.forEach(select => {
          select.value = '';
        });
        if (searchInput) {
          searchInput.value = '';
        }
        currentPage = 1;
        filterCards();
      }

      function saveState() {
        const state = {
          search: searchInput ? searchInput.value : '',
          page: currentPage,
          selects: Array.from(selectFilters).map(select => ({
            name: select.dataset.filterName,
            value: select.value
          })),
          checkboxes: Array.from(checkboxFilters)
            .filter(checkbox => checkbox.checked)
            .map(checkbox => ({
              name: checkbox.dataset.filterName,
              value: checkbox.value
            })),
          datePeriods: Array.from(datePeriodFilters)
            .filter(radio => radio.checked)
            .map(radio => ({
              name: radio.dataset.filterName,
              value: radio.value
            })),
          dateYears: Array.from(dateYearFilters).map(select => ({
            name: select.dataset.filterName,
            value: select.value
          }))
        };
        try {
          sessionStorage.setItem(storageKey, JSON.stringify(state));
        } catch (e) {
          // Ignore storage errors (private mode, etc.)
        }
      }

      function restoreState() {
        let raw = null;
        try {
          raw = sessionStorage.getItem(storageKey);
        } catch (e) {
          raw = null;
        }
        if (!raw) return;
        let state = null;
        try {
          state = JSON.parse(raw);
        } catch (e) {
          state = null;
        }
        if (!state) return;

        if (searchInput && typeof state.search === 'string') {
          searchInput.value = state.search;
        }

        if (Array.isArray(state.selects)) {
          state.selects.forEach(saved => {
            const match = Array.from(selectFilters).find(select => select.dataset.filterName === saved.name);
            if (match) {
              match.value = saved.value || '';
            }
          });
        }

        if (Array.isArray(state.checkboxes)) {
          state.checkboxes.forEach(saved => {
            const match = Array.from(checkboxFilters).find(checkbox => checkbox.dataset.filterName === saved.name && checkbox.value === saved.value);
            if (match) {
              match.checked = true;
            }
          });
        }

        if (Array.isArray(state.datePeriods)) {
          state.datePeriods.forEach(saved => {
            const match = Array.from(datePeriodFilters).find(radio => radio.dataset.filterName === saved.name && radio.value === saved.value);
            if (match) {
              match.checked = true;
            }
          });
        }

        if (Array.isArray(state.dateYears)) {
          state.dateYears.forEach(saved => {
            const match = Array.from(dateYearFilters).find(select => select.dataset.filterName === saved.name);
            if (match) {
              match.value = saved.value || '';
            }
          });
        }

        if (typeof state.page === 'number' && state.page > 0) {
          currentPage = state.page;
        }

        try {
          sessionStorage.removeItem(storageKey);
        } catch (e) {
          // Ignore storage errors
        }
      }

      const cardLinks = panel.querySelectorAll('.item-card a');
      cardLinks.forEach(link => {
        link.addEventListener('click', () => {
          saveState();
          const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
          try {
            const url = new URL(link.href, window.location.origin);
            url.searchParams.set('from', current);
            link.href = `${url.pathname}${url.search}${url.hash}`;
          } catch (e) {
            // Ignore URL parsing errors
          }
        });
      });

      selectFilters.forEach(select => {
        select.addEventListener('change', () => {
          currentPage = 1;
          filterCards();
        });
      });

      checkboxFilters.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
          currentPage = 1;
          filterCards();
        });
      });

      datePeriodFilters.forEach(radio => {
        radio.addEventListener('change', () => {
          currentPage = 1;
          filterCards();
        });
      });

      dateYearFilters.forEach(select => {
        select.addEventListener('change', () => {
          currentPage = 1;
          filterCards();
        });
      });

      let searchTimeout;
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            currentPage = 1;
            filterCards();
          }, 300);
        });
      }

      if (clearButton) {
        clearButton.addEventListener('click', clearAllFilters);
      }

      restoreState();
      filterCards();
    }

    tabPanels.forEach(panel => setupFilters(panel));

    const storedTab = (() => {
      try {
        return sessionStorage.getItem('homeActiveTab');
      } catch (e) {
        return null;
      }
    })();
    const defaultTab = storedTab && tabButtons.find(button => button.dataset.tabButton === storedTab)
      ? storedTab
      : tabButtons[0].dataset.tabButton;

    activateTab(defaultTab);

    tabButtons.forEach(button => {
      button.addEventListener('click', function() {
        activateTab(button.dataset.tabButton);
        try {
          sessionStorage.setItem('homeActiveTab', button.dataset.tabButton);
        } catch (e) {
          // Ignore storage errors
        }
      });
    });
  });
</script>
