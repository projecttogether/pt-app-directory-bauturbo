{# MARKUP #}
{##########}

<div class="px-5 sm:px-pad-directory-section-x 
            pt-5 sm:pt-pad-directory-section-x
            select-none">
    <details class="group" open>

        {# Group label/collapse btn. #}
        <summary class="cursor-pointer list-none flex items-center justify-between">
            <span class="text-label-xxs">{{ filter.label }}</span>
            <svg class="size-4 fill-bauturbo-blau transition-transform group-open:rotate-180" viewBox="0 0 24 24">
                <path stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
        </summary>
        
        {# Filter options #}
        <div class="mt-3">

            {# Range-type filter options #}
            {% if filter.type == 'date_range' %}
                <div data-filter-name="{{ filter.field }}" data-filter-type="{{ filter.type }}">
                    <div class="space-y-2 mb-4">
                        <label class="flex items-center cursor-pointer bg-theme-hover p-1 rounded transition-colors">
                            <input type="radio"
                                class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                style="border-color: var(--color-primary); accent-color: var(--color-primary);"
                                name="date-period-{{ dir.id }}-{{ filter.field }}"
                                data-filter-name="{{ filter.field }}"
                                data-filter-type="{{ filter.type }}"
                                value="all"
                                checked>
                            <span class="ml-2 text-sm directories-filter-text">Alle Einträge</span>
                        </label>
                        <label class="flex items-center cursor-pointer bg-theme-hover p-1 rounded transition-colors">
                            <input type="radio"
                                class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                style="border-color: var(--color-primary); accent-color: var(--color-primary);"
                                name="date-period-{{ dir.id }}-{{ filter.field }}"
                                data-filter-name="{{ filter.field }}"
                                data-filter-type="{{ filter.type }}"
                                value="upcoming">
                            <span class="ml-2 text-sm directories-filter-text">In der Zukunft</span>
                        </label>
                        <label class="flex items-center cursor-pointer bg-theme-hover p-1 rounded transition-colors">
                            <input type="radio"
                                class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                style="border-color: var(--color-primary); accent-color: var(--color-primary);"
                                name="date-period-{{ dir.id }}-{{ filter.field }}"
                                data-filter-name="{{ filter.field }}"
                                data-filter-type="{{ filter.type }}"
                                value="past">
                            <span class="ml-2 text-sm directories-filter-text">In der Vergangenheit</span>
                        </label>
                    </div>

                    {% if filter.years.length > 0 %}
                    <div>
                    <label class="block text-xs font-medium directories-filter-text mb-2">Jahr (optional)</label>
                    <select class="filter-date-year block w-full px-3 py-2 text-sm rounded-md border bg-theme"
                            style="border-color: var(--color-primary);"
                            data-filter-name="{{ filter.field }}"
                            data-filter-type="{{ filter.type }}">
                        <option value="">Alle Jahre</option>
                        {% for year in filter.years %}
                        <option value="{{ year }}">{{ year }}</option>
                        {% endfor %}
                    </select>
                    </div>
                    {% endif %}
                </div>

            {# Multi-select filter options #}
            {% elif filter.type == 'multi_select' %}

                <div class="flex flex-col items-start gap-2.5" 
                     data-filter-name="{{ filter.field }}" 
                     data-filter-type="{{ filter.type }}">

                    {% for option in filter.options %}
                        <label class="p-0 flex items-baseline gap-x-2 cursor-pointer">
                            <input 
                                type="checkbox"
                                data-filter-name="{{ filter.field }}"
                                data-filter-type="{{ filter.type }}"
                                value="{{ option }}"
                                class="filter-checkbox appearance-none size-3.25 shrink-0
                                       border border-bauturbo-blau bg-white checked:bg-bauturbo-blau 
                                       outline-none! focus:outline-none! focus:ring-0! focus:ring-offset-0!">
                            <span class="text-btn-sm leading-[1.15]! text-bauturbo-blau">{{ option }}</span>
                        </label>
                    {% endfor %}

                </div>

            {% else %}
                <select class="filter-select block w-full px-3 py-2 text-sm rounded-md border bg-theme"
                        style="border-color: var(--color-primary);"
                        data-filter-name="{{ filter.field }}"
                        data-filter-type="{{ filter.type }}">
                    <option value="">Alle</option>
                    {% for option in filter.options %}
                        <option value="{{ option }}">{{ option }}</option>
                    {% endfor %}
                </select>
            {% endif %}
        </div>
    </details>
</div>
