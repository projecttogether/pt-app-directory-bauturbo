{# SETUP #}
{#########}

{% set is_first = loop.first %}

{# MARKUP #}
{##########}

<section
    id="panel-{{ dir.id }}"
    data-tab-panel="{{ dir.id }}"
    role="tabpanel"
    aria-labelledby="tab-{{ dir.id }}"
    class="_border border-x border-bauturbo-blau
           {% if not is_first %} hidden {% endif %}">
    
    {# Inner grid wrapper #}
    <div class="w-full grid grid-cols-12 gap-x-7.5">

        {# Directory description + show-all link #}
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 hidden">
            <div class="max-w-3xl">
                <h3 class="text-2xl font-bold text-primary">{{ dir.name }}</h3>
                {% if dir.description %}
                    <p class="mt-3 text-theme-muted leading-relaxed">{{ dir.description }}</p>
                {% endif %}
            </div>
            <a href="{{ dir.path }}" class="inline-flex items-center text-sm font-semibold text-primary hover:underline">
                Alle Eintraege anzeigen
            </a>
        </div>

        {# Filter sidebar #}
        {% include "components/directories-tabs/directory-filter-sidebar.njk" %}

        <div class="flex flex-col lg:flex-row gap-8">

            <div class="flex-1">
            <div class="flex items-center justify-between text-sm font-semibold text-theme mb-4">
                {% set itemCount = dir.items | length %}
                <span class="directories-label" data-results-count>
                {{ itemCount }} {% if itemCount == 1 %}ERGEBNIS{% else %}ERGEBNISSE{% endif %}
                </span>
                <div class="directories-pagination" data-pagination></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" data-items-grid>
                {% for item in dir.items %}
                <article class="item-card group directories-card bg-theme p-6 transition-shadow hover:shadow-md"
                        {% for filter in dir.filters %}
                        {% set value = item[filter.field] %}
                        {% if value %}
                        data-{{ filter.field }}="{{ value | attrSafe }}"
                        {% endif %}
                        {% endfor %}
                >
                <a href="{{ dir.path }}/items/{{ item.Id }}/?from={{ page.url | default('/') }}" class="block">
                    <h4 class="text-lg font-semibold directories-title group-hover:text-primary transition-colors">
                    {{ item[dir.display.title_field] }}
                    </h4>
                    <div class="flex items-center gap-2 text-xs text-theme-soft mt-2">
                    {% if dir.display.status_field and item[dir.display.status_field] %}
                    <span class="inline-flex items-center px-2 py-0.5 directories-pill">
                        {{ item[dir.display.status_field] }}
                    </span>
                    {% endif %}
                    {% if dir.display.start_date_field and item[dir.display.start_date_field] %}
                    <span>
                        {{ item[dir.display.start_date_field] | formatDate }}
                    </span>
                    {% endif %}
                    </div>
                    {% if dir.display.excerpt_field and item[dir.display.excerpt_field] %}
                    <p class="mt-3 text-sm text-theme-muted leading-relaxed">
                    {{ item[dir.display.excerpt_field] | truncateChars(200) }}
                    </p>
                    {% endif %}
                    <span class="inline-flex items-center px-3 py-1.5 mt-4 text-sm font-semibold border directories-button">
                    Mehr erfahren
                    </span>
                </a>
                </article>
                {% else %}
                <div class="col-span-full text-center py-12 text-theme-muted">
                Keine veroeffentlichten Eintraege gefunden.
                </div>
                {% endfor %}
            </div>
            </div>
        </div>

    </div>
</section>