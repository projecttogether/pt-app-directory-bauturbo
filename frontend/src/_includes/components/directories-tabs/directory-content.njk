{# SETUP #}
{#########}

{% set is_first = loop.first %}

{# MARKUP #}
{##########}

<section
    id="panel-{{ dir.id }}"
    data-tab-panel="{{ dir.id }}"
    role="tabpanel"
    aria-labelledby="tab-{{ dir.id }}"
    class="pb-[calc(var(--pb-inner)+var(--mb))]
           border-x border-bauturbo-blau
           {% if not is_first %} hidden {% endif %}">
    
    {# Inner grid wrapper #}
    <div class="w-full grid grid-cols-12 gap-x-pad-directory-section-x">

        <div class="col-span-12 px-5 sm:px-pad-directory-section-x 
                    py-5 sm:py-pad-directory-section-x
                    border-b border-bauturbo-blau">
        {% if dir.description %}
            <p class="text-sm">{{ dir.description }}</p>
        {% endif %}
    </div>

        {# Directory description + show-all link #}
        <div class="flex_ flex-col lg:flex-row lg:items-start lg:justify-between gap-4 hidden">
            <div class="max-w-3xl">
                <h3 class="text-2xl font-bold text-primary">{{ dir.name }}</h3>
                {% if dir.description %}
                    <p class="mt-3 text-theme-muted leading-relaxed">{{ dir.description }}</p>
                {% endif %}
            </div>
            <a href="{{ dir.path }}" class="inline-flex items-center text-sm font-semibold text-primary hover:underline">
                Alle Eintraege anzeigen
            </a>
        </div>

        {# Filter sidebar #}
        {% include "components/directories-tabs/directory-filter-sidebar.njk" %}

        {# Items grid #}
        <div class="col-span-12 md:col-span-9 
                    px-5 sm:pr-pad-directory-section-x
                    py-5 sm:py-pad-directory-section-x 
                    max-sm:pl-5
                    max-md:pl-pad-directory-section-x
                    flex flex-col lg:flex-row gap-pad-content-section-x">

            <div class="w-full">
                <div class="flex items-center justify-between text-sm font-semibold text-theme mb-4">
                    {% set itemCount = dir.items | length %}
                    <span class="text-label-xs" data-results-count>
                        {{ itemCount }} {% if itemCount == 1 %}ERGEBNIS{% else %}ERGEBNISSE{% endif %}
                    </span>
                </div>

                {# Grid wrapper #}
                <div data-items-grid
                     class="grid grid-cols-1 sm:grid-cols-2 gap-6">

                    {# Grid items #}
                    {% for item in dir.items %}
                            {% include "components/directories-tabs/directory-grid-item.njk" %}
                        {% else %}
                            <div class="col-span-full text-center py-12">
                                Keine veroeffentlichten Eintraege gefunden.
                            </div>
                    {% endfor %}
                </div>

                {# Pagination #}
                <footer class="w-full mt-6 flex justify-end">
                    <div class="directories-pagination" data-pagination></div>
                </footer>
            </div>
        </div>

    </div>
</section>