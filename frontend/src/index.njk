---
layout: layouts/base.njk
permalink: /
eleventyComputed:
  eleventyExcludeFromCollections: true
---

{% set firstDirectory = directories[0] %}

<script>
  // Redirect to the first directory
  window.location.href = '{{ firstDirectory.path }}';
</script>

<div class="text-center py-12">
  <p class="text-gray-600 mb-4">Redirecting to {{ firstDirectory.name }}...</p>
  <a href="{{ firstDirectory.path }}" class="text-indigo-600 hover:text-indigo-800 underline">
    Click here if you are not redirected automatically
  </a>
</div>
