---
pagination:
  data: directories
  size: 1
  alias: directory
permalink: "{{ directory.path }}/index.html"
layout: layouts/base.njk
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-gray-900">{{ directory.name }}</h2>
        
        {% if directory.filters.length > 0 %}
        <!-- Mobile Filter Button -->
        <button id="mobile-filter-btn" class="lg:hidden inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 shadow-sm">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
            </svg>
            Filter
        </button>
        {% endif %}
    </div>
    
    {% if directory.description %}
    <p class="text-lg text-gray-600 mb-8">{{ directory.description }}</p>
    {% endif %}
    
    <!-- Title underline aligned with page title and header menu -->
    <div class="border-b border-1-5 border-text mb-8"></div>
    
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Filter Overlay for Mobile -->
        <div id="filter-overlay" class="filter-overlay"></div>
        
        <!-- Left Sidebar - Filters -->
        {% if directory.filters.length > 0 %}
        <aside id="filter-sidebar" class="lg:w-64 flex-shrink-0 filter-sidebar lg:static">
            <div class="p-4 lg:sticky lg:top-4" style="background-color: var(--color-background);">
                <!-- Mobile Close Button -->
                <div class="flex items-center justify-between mb-4 lg:hidden">
                    <h3 class="text-lg font-semibold text-gray-900">Filter</h3>
                    <button id="close-filter-btn" class="text-gray-400 hover:text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                
                <div class="hidden lg:flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900">Filter</h3>
                    <button id="clear-filters" class="text-xs text-gray-500 hover:text-gray-900 transition-colors">
                        Alle Filter löschen
                    </button>
                </div>
                
                <!-- Clear Filters for Mobile -->
                <button id="clear-filters-mobile" class="lg:hidden w-full mb-4 text-sm text-gray-500 hover:text-gray-900 transition-colors text-center">
                    Alle Filter löschen
                </button>
                
                <!-- Search Box -->
                <div class="mb-4 pb-4" style="border-bottom: 1.5px solid var(--color-text);">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Suche</label>
                    <input type="text" 
                           id="search-input" 
                           class="block w-full px-3 py-2 text-sm rounded-md border bg-white"
                           style="border-color: var(--color-text);"
                           placeholder="Stichwort eingeben...">
                </div>
                
                <div class="space-y-4" id="filter-container">
                    {% for filter in directory.filters %}
                    <div class="pb-4 last:pb-0" style="border-bottom: 1.5px solid var(--color-text); {% if loop.last %}border-bottom: none;{% endif %}">
                        <details class="group" open>
                            <summary class="cursor-pointer list-none flex items-center justify-between text-sm font-medium text-gray-700 hover:text-gray-900">
                                <span>{{ filter.label }}</span>
                                <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </summary>
                            <div class="mt-3">
                                {% if filter.type == 'date_range' %}
                                    <!-- Date range filter with period and year -->
                                    <div data-filter-name="{{ filter.field }}" data-filter-type="{{ filter.type }}">
                                        <!-- Time period radio buttons -->
                                        <div class="space-y-2 mb-4">
                                            <label class="flex items-center cursor-pointer hover:bg-gray-50 p-1 rounded transition-colors">
                                                <input type="radio" 
                                                       class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                                       style="border-color: var(--color-text); accent-color: var(--color-primary);"
                                                       name="date-period-{{ filter.field }}"
                                                       data-filter-name="{{ filter.field }}"
                                                       data-filter-type="{{ filter.type }}"
                                                       value="all"
                                                       checked>
                                                <span class="ml-2 text-sm text-gray-700">Alle Veranstaltungen</span>
                                            </label>
                                            <label class="flex items-center cursor-pointer hover:bg-gray-50 p-1 rounded transition-colors">
                                                <input type="radio" 
                                                       class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                                       style="border-color: var(--color-text); accent-color: var(--color-primary);"
                                                       name="date-period-{{ filter.field }}"
                                                       data-filter-name="{{ filter.field }}"
                                                       data-filter-type="{{ filter.type }}"
                                                       value="upcoming">
                                                <span class="ml-2 text-sm text-gray-700">Zukünftige Veranstaltungen</span>
                                            </label>
                                            <label class="flex items-center cursor-pointer hover:bg-gray-50 p-1 rounded transition-colors">
                                                <input type="radio" 
                                                       class="filter-date-period rounded-full text-primary focus:ring-0 focus:ring-offset-0"
                                                       style="border-color: var(--color-text); accent-color: var(--color-primary);"
                                                       name="date-period-{{ filter.field }}"
                                                       data-filter-name="{{ filter.field }}"
                                                       data-filter-type="{{ filter.type }}"
                                                       value="past">
                                                <span class="ml-2 text-sm text-gray-700">Vergangene Veranstaltungen</span>
                                            </label>
                                        </div>
                                        
                                        <!-- Year dropdown -->
                                        {% if filter.years.length > 0 %}
                                        <div>
                                            <label class="block text-xs font-medium text-gray-700 mb-2">Jahr (optional)</label>
                                            <select class="filter-date-year block w-full px-3 py-2 text-sm rounded-md border bg-white" 
                                                    style="border-color: var(--color-text);"
                                                    data-filter-name="{{ filter.field }}"
                                                    data-filter-type="{{ filter.type }}">
                                                <option value="">Alle Jahre</option>
                                                {% for year in filter.years %}
                                                <option value="{{ year }}">{{ year }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        {% endif %}
                                    </div>
                                {% elif filter.type == 'multi_select' %}
                                    <!-- Checkbox list for multi-select -->
                                    <div class="space-y-2 max-h-60 overflow-y-auto" data-filter-name="{{ filter.field }}" data-filter-type="{{ filter.type }}">
                                        {% for option in filter.options %}
                                        <label class="flex items-center cursor-pointer hover:bg-gray-50 p-1 rounded transition-colors">
                                            <input type="checkbox" 
                                                   class="filter-checkbox rounded text-primary focus:ring-0 focus:ring-offset-0"
                                                   style="border-color: var(--color-text); accent-color: var(--color-primary);"
                                                   data-filter-name="{{ filter.field }}"
                                                   data-filter-type="{{ filter.type }}"
                                                   value="{{ option }}">
                                            <span class="ml-2 text-sm text-gray-700">{{ option }}</span>
                                        </label>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <!-- Dropdown for single select -->
                                    <select class="filter-select block w-full px-3 py-2 text-sm rounded-md border bg-white" 
                                            style="border-color: var(--color-text);"
                                            data-filter-name="{{ filter.field }}"
                                            data-filter-type="{{ filter.type }}">
                                        <option value="">Alle</option>
                                        {% for option in filter.options %}
                                        <option value="{{ option }}">{{ option }}</option>
                                        {% endfor %}
                                    </select>
                                {% endif %}
                            </div>
                        </details>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </aside>
        {% endif %}
        
        <!-- Main Content - Cards Grid -->
        <div class="flex-1">
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="items-grid">
            {% for item in directory.items %}
                <div class="item-card rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden border border-gray-100"
                     style="background-color: var(--color-background);"
                     {% for filter in directory.filters %}
                        {% set value = item[filter.field] %}
                        {% if value %}
                        data-{{ filter.field }}="{{ value }}"
                        {% endif %}
                     {% endfor %}
                >
                    <a href="{{ directory.path }}/items/{{ item.Id }}/?from={{ directory.path }}" class="block p-6 hover:bg-gray-50 transition-colors">
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">
                            {{ item[directory.display.title_field] }}
                        </h3>
                        
                        {% if (directory.display.status_field and item[directory.display.status_field]) or (directory.display.start_date_field and item[directory.display.start_date_field]) %}
                        <div class="flex items-center gap-3 mb-3">
                            {% if directory.display.status_field and item[directory.display.status_field] %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium whitespace-nowrap" style="background-color: var(--color-gray-light); color: var(--color-text);">
                                {{ item[directory.display.status_field] }}
                            </span>
                            {% endif %}
                            
                            {% if directory.display.start_date_field and item[directory.display.start_date_field] %}
                            <span class="text-xs text-gray-500">
                                {{ item[directory.display.start_date_field] | formatDate }}
                            </span>
                            {% endif %}
                        </div>
                        {% endif %}
                        
                        {% if directory.display.excerpt_field and item[directory.display.excerpt_field] %}
                        <p class="text-sm text-gray-600 leading-relaxed">
                            {{ item[directory.display.excerpt_field] }}
                        </p>
                        {% endif %}
                    </a>
                </div>
            {% else %}
                <div class="col-span-full text-center py-12 text-gray-500">
                    Keine Einträge gefunden.
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const selectFilters = document.querySelectorAll('.filter-select');
    const checkboxFilters = document.querySelectorAll('.filter-checkbox');
    const datePeriodFilters = document.querySelectorAll('.filter-date-period');
    const dateYearFilters = document.querySelectorAll('.filter-date-year');
    const searchInput = document.getElementById('search-input');
    const cards = document.querySelectorAll('.item-card');
    const clearButton = document.getElementById('clear-filters');
    const clearButtonMobile = document.getElementById('clear-filters-mobile');
    const storageKey = "directoryFilters:{{ directory.id }}";
    
    // Mobile filter toggle
    const mobileFilterBtn = document.getElementById('mobile-filter-btn');
    const filterSidebar = document.getElementById('filter-sidebar');
    const filterOverlay = document.getElementById('filter-overlay');
    const closeFilterBtn = document.getElementById('close-filter-btn');
    
    function openMobileFilter() {
        if (filterSidebar && filterOverlay) {
            filterSidebar.classList.add('open');
            filterOverlay.classList.add('open');
            document.body.style.overflow = 'hidden';
        }
    }
    
    function closeMobileFilter() {
        if (filterSidebar && filterOverlay) {
            filterSidebar.classList.remove('open');
            filterOverlay.classList.remove('open');
            document.body.style.overflow = '';
        }
    }
    
    if (mobileFilterBtn) {
        mobileFilterBtn.addEventListener('click', openMobileFilter);
    }
    
    if (closeFilterBtn) {
        closeFilterBtn.addEventListener('click', closeMobileFilter);
    }
    
    if (filterOverlay) {
        filterOverlay.addEventListener('click', closeMobileFilter);
    }

    function filterCards() {
        const activeFilters = {};
        const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
        
        // Collect date range filters
        datePeriodFilters.forEach(radio => {
            if (radio.checked) {
                const filterName = radio.dataset.filterName;
                if (!activeFilters[filterName]) {
                    activeFilters[filterName] = { type: 'date_range' };
                }
                activeFilters[filterName].period = radio.value;
            }
        });
        
        dateYearFilters.forEach(select => {
            if (select.value) {
                const filterName = select.dataset.filterName;
                if (!activeFilters[filterName]) {
                    activeFilters[filterName] = { type: 'date_range' };
                }
                activeFilters[filterName].year = parseInt(select.value);
            }
        });
        
        // Collect selected dropdowns (single select)
        selectFilters.forEach(select => {
            if (select.value) {
                activeFilters[select.dataset.filterName] = {
                    value: select.value,
                    type: select.dataset.filterType
                };
            }
        });
        
        // Collect checked checkboxes (multi-select)
        const checkboxesByFilter = {};
        checkboxFilters.forEach(checkbox => {
            const filterName = checkbox.dataset.filterName;
            if (!checkboxesByFilter[filterName]) {
                checkboxesByFilter[filterName] = [];
            }
            if (checkbox.checked) {
                checkboxesByFilter[filterName].push(checkbox.value);
            }
        });
        
        // Add checked checkboxes to activeFilters
        for (const [filterName, values] of Object.entries(checkboxesByFilter)) {
            if (values.length > 0) {
                activeFilters[filterName] = {
                    values: values,
                    type: 'multi_select'
                };
            }
        }

        const now = new Date();
        now.setHours(0, 0, 0, 0); // Set to start of today

        cards.forEach(card => {
            let isVisible = true;
            
            // Apply filter-based filtering
            for (const [key, filterConfig] of Object.entries(activeFilters)) {
                const cardValue = card.getAttribute(`data-${key}`);
                
                if (filterConfig.type === 'date_range') {
                    if (!cardValue) {
                        isVisible = false;
                        break;
                    }
                    
                    const cardDate = new Date(cardValue);
                    if (isNaN(cardDate.getTime())) {
                        isVisible = false;
                        break;
                    }
                    
                    // Apply period filter
                    if (filterConfig.period === 'upcoming' && cardDate < now) {
                        isVisible = false;
                        break;
                    }
                    if (filterConfig.period === 'past' && cardDate >= now) {
                        isVisible = false;
                        break;
                    }
                    
                    // Apply year filter
                    if (filterConfig.year && cardDate.getFullYear() !== filterConfig.year) {
                        isVisible = false;
                        break;
                    }
                    
                    continue;
                }
                
                if (!cardValue) {
                    isVisible = false;
                    break;
                }
                
                // For multi-select fields, check if ANY selected filter value is in the card's comma-separated list
                if (filterConfig.type === 'multi_select') {
                    const cardValues = cardValue.split(',').map(v => v.trim());
                    const hasMatch = filterConfig.values.some(filterVal => 
                        cardValues.includes(filterVal)
                    );
                    
                    if (!hasMatch) {
                        isVisible = false;
                        break;
                    }
                } else {
                    // For single select, exact match
                    if (cardValue !== filterConfig.value) {
                        isVisible = false;
                        break;
                    }
                }
            }
            
            // Apply text search
            if (isVisible && searchTerm) {
                const cardText = card.textContent.toLowerCase();
                if (!cardText.includes(searchTerm)) {
                    isVisible = false;
                }
            }
            
            card.style.display = isVisible ? 'block' : 'none';
        });
    }
    
    function clearAllFilters() {
        selectFilters.forEach(select => {
            select.value = '';
        });
        checkboxFilters.forEach(checkbox => {
            checkbox.checked = false;
        });
        datePeriodFilters.forEach(radio => {
            radio.checked = radio.value === 'all';
        });
        dateYearFilters.forEach(select => {
            select.value = '';
        });
        if (searchInput) {
            searchInput.value = '';
        }
        filterCards();
        closeMobileFilter();
    }

    function saveState() {
        const state = {
            search: searchInput ? searchInput.value : '',
            selects: Array.from(selectFilters).map(select => ({
                name: select.dataset.filterName,
                value: select.value
            })),
            checkboxes: Array.from(checkboxFilters)
                .filter(checkbox => checkbox.checked)
                .map(checkbox => ({
                    name: checkbox.dataset.filterName,
                    value: checkbox.value
                })),
            datePeriods: Array.from(datePeriodFilters)
                .filter(radio => radio.checked)
                .map(radio => ({
                    name: radio.dataset.filterName,
                    value: radio.value
                })),
            dateYears: Array.from(dateYearFilters).map(select => ({
                name: select.dataset.filterName,
                value: select.value
            }))
        };
        try {
            sessionStorage.setItem(storageKey, JSON.stringify(state));
        } catch (e) {
            // Ignore storage errors
        }
    }

    function restoreState() {
        let raw = null;
        try {
            raw = sessionStorage.getItem(storageKey);
        } catch (e) {
            raw = null;
        }
        if (!raw) return;
        let state = null;
        try {
            state = JSON.parse(raw);
        } catch (e) {
            state = null;
        }
        if (!state) return;

        if (searchInput && typeof state.search === 'string') {
            searchInput.value = state.search;
        }

        if (Array.isArray(state.selects)) {
            state.selects.forEach(saved => {
                const match = Array.from(selectFilters).find(select => select.dataset.filterName === saved.name);
                if (match) {
                    match.value = saved.value || '';
                }
            });
        }

        if (Array.isArray(state.checkboxes)) {
            state.checkboxes.forEach(saved => {
                const match = Array.from(checkboxFilters).find(checkbox => checkbox.dataset.filterName === saved.name && checkbox.value === saved.value);
                if (match) {
                    match.checked = true;
                }
            });
        }

        if (Array.isArray(state.datePeriods)) {
            state.datePeriods.forEach(saved => {
                const match = Array.from(datePeriodFilters).find(radio => radio.dataset.filterName === saved.name && radio.value === saved.value);
                if (match) {
                    match.checked = true;
                }
            });
        }

        if (Array.isArray(state.dateYears)) {
            state.dateYears.forEach(saved => {
                const match = Array.from(dateYearFilters).find(select => select.dataset.filterName === saved.name);
                if (match) {
                    match.value = saved.value || '';
                }
            });
        }

        try {
            sessionStorage.removeItem(storageKey);
        } catch (e) {
            // Ignore storage errors
        }
    }

    cards.forEach(card => {
        const link = card.querySelector('a');
        if (!link) return;
        link.addEventListener('click', () => {
            saveState();
            const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
            try {
                const url = new URL(link.href, window.location.origin);
                url.searchParams.set('from', current);
                link.href = `${url.pathname}${url.search}${url.hash}`;
            } catch (e) {
                // Ignore URL parsing errors
            }
        });
    });

    selectFilters.forEach(select => {
        select.addEventListener('change', filterCards);
    });
    
    checkboxFilters.forEach(checkbox => {
        checkbox.addEventListener('change', filterCards);
    });
    
    datePeriodFilters.forEach(radio => {
        radio.addEventListener('change', filterCards);
    });
    
    dateYearFilters.forEach(select => {
        select.addEventListener('change', filterCards);
    });
    
    // Search with debounce
    let searchTimeout;
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(filterCards, 300);
        });
    }

    if (clearButton) {
        clearButton.addEventListener('click', clearAllFilters);
    }
    
    if (clearButtonMobile) {
        clearButtonMobile.addEventListener('click', clearAllFilters);
    }

    restoreState();
    filterCards();
});
</script>
