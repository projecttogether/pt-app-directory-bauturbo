# NocoDB Configuration
# Copy this file to .env and fill in your actual values
# By default, these values are set for the local docker-compose environment

# NocoDB instance base URL
NOCODB_BASE_URL=http://localhost:8080

# NocoDB API authentication token
# Note: For local docker-compose setup, generate this in the NocoDB UI after initial login
NOCODB_API_TOKEN=your_api_token_here

# NocoDB project ID
# Note: For local setup, this is typically the ID of the base after importing
NOCODB_PROJECT_ID=p1234567890

# Note: Table and view IDs are configured in config.yml
