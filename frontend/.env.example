# NocoDB Configuration
# Copy this file to .env and fill in your actual values

# NocoDB instance base URL
NOCODB_BASE_URL=https://nocodb.projecttogether.org

# NocoDB API authentication token
NOCODB_API_TOKEN=your_api_token_here

# NocoDB project ID (found in project URL)
NOCODB_PROJECT_ID=px8pby5vdjxwo13

# Note: Table and view IDs are now configured in config/directories.yml
